      "roundness": null,
      "fontSize": 14,
      "fontFamily": 3,
      "text": "df = spark.read.parquet(\"data/\")   # 8 partitions\ndf = df.filter(col(\"amt\") > 100)    # narrow\ndf = df.withColumn(\"cat\", ...)      # narrow\ndf = df.groupBy(\"cat\").sum(\"amt\")  # WIDE - shuffle 1\ndf = df.orderBy(\"cat\")              # WIDE - shuffle 2\ndf.write.csv(\"out/\")                # action -> Job",
      "rawText": "df = spark.read.parquet(\"data/\")   # 8 partitions\ndf = df.filter(col(\"amt\") > 100)    # narrow\ndf = df.withColumn(\"cat\", ...)      # narrow\ndf = df.groupBy(\"cat\").sum(\"amt\")  # WIDE - shuffle 1\ndf = df.orderBy(\"cat\")              # WIDE - shuffle 2\ndf.write.csv(\"out/\")                # action -> Job",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "df = spark.read.parquet(\"data/\")   # 8 partitions\ndf = df.filter(col(\"amt\") > 100)    # narrow\ndf = df.withColumn(\"cat\", ...)      # narrow\ndf = df.groupBy(\"cat\").sum(\"amt\")  # WIDE - shuffle 1\ndf = df.orderBy(\"cat\")              # WIDE - shuffle 2\ndf.write.csv(\"out/\")                # action -> Job",
      "lineHeight": 1.25
    },
